# Next.js — production build (npm run build). Copy to .env.production for local prod builds
# Docker: root compose passes NEXT_PUBLIC_* as build args from .env.production (see scripts/docker-prod.sh)
#
#   cp .env.production.example .env.production

NEXT_PUBLIC_API_URL=https://lotfood.ru/api
NEXT_PUBLIC_BACKEND_URL=https://lotfood.ru
