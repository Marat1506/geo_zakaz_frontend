# Next.js loads, in order: .env, .env.local, .env.development / .env.production (by mode).
#
#   cp .env.development.example .env.development   # npm run dev
#   cp .env.production.example .env.production     # npm run build (optional)
#
# Docker: set NEXT_PUBLIC_* in repo root `.env.development` or `.env.production` for compose build args.
